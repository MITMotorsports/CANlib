{%- macro enumsio(bus, msg, msg_name=msg.name) -%}
{%- if msg.frame is defined -%}
{% for sub_frame in msg.frame -%}
{{ enumsio(bus, sub_frame, msg_name + '_' + sub_frame.name) }}
{%- endfor -%}
{%- else -%}
{%- for atom in msg.atom -%}
{%- if atom.type.isenum() -%}

template<>
inline CANlib_{{ bus.name }}_{{ msg_name }}_{{ atom.name }}_T str_to_T(const char* str) {
{%- for enum in atom.type.enum %}
  if(strcmp(str, "{{ enum.name }}") == 0) {
    return CANlib_{{ bus.name }}_{{ msg_name }}_{{ atom.name }}_{{ enum.name }};
  }
{%- endfor %}
  return CANlib_{{ bus.name }}_{{ msg_name }}_{{ atom.name }}_NUM_FIELDS;
}

{% endif -%}
{%- endfor -%}
{%- endif -%}
{%- endmacro -%}

#pragma once
#include "io.h"
#include "enum_atom.h"
#include <string.h>

namespace common {

{% for bus in can.bus -%}
// {{ bus.name }}
{% for msg in bus.frame -%}
  {{ enumsio(bus, msg) }}
{%- endfor -%}
{%- endfor -%}

}