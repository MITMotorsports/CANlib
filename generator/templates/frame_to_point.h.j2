{%- macro handle_stuff(bus_name, msg, msg_name=msg.name) -%}
{%- if msg.frame is defined -%}
{%- for sub_frame in msg.frame -%}
{{ handle_stuff(bus_name, sub_frame, msg_name + '_' + sub_frame.name) }}
{%- endfor -%}
{%- else -%}
void CANlib_FrameToPoint_{{ bus_name }}_{{ msg_name }}(Point* point_addr, Frame *frame);
{% endif -%}
{%- endmacro -%}

#pragma once

#include <stdint.h>
#include <stdbool.h>

#include "driver.h"
#include "constants.h"
#include "enum_atom.h"
#include "structs.h"
#include "static.h"
#include "evil_macros.h"
#include "bus.h"
#include "pack_unpack.h"
#include "Point.h"
using namespace influxdb;

{% for bus_name, bus in computer.participation['name']['can'].subscribe.items() %}
{% for frame in bus -%}
{{ handle_stuff(bus_name, frame) -}}
{%- endfor -%}
{% endfor %}
void CANlib_FrameToPoint(Point* point_addr, CAN_Raw_Bus_T raw_bus, Frame* frame);