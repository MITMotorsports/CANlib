{% for msg in canalyzer_bus.frame -%}
BO_ {{msg.key}} {{msg.name}}: {{ msg.length() }} Vector__XXX
{%- for atom in msg.atom %}
{%- if atom.type.endianness.isbig() and (atom.slice.length % 8 == 0) %}
 SG_ {{atom.name}} : {{((atom.slice.start//8)+1)*8 - (atom.slice.start%8 + 1)}}|{{atom.slice.length}}@0{{'-' if atom.type.issigned() else '+'}} (1,0) [0|0] "" Vector__XXX
{%- else %}
 SG_ {{atom.name}} : {{ atom.slice.start }}|{{atom.slice.length}}@1{{'-' if atom.type.issigned() else '+'}} (1,0) [0|0] "" Vector__XXX
{%- endif -%}
{%- endfor %}

{% endfor %}

