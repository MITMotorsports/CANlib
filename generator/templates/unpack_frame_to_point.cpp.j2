{%- macro get_atom_value(atom) -%}
{%- if all_unit_files is not none and atom.unit in unit_types -%}
parsed_frame->{{ atom.name }}.in<{{ atom.type.ctype() }}>({{ unit_types[atom.unit] }}{})
{%- else -%}
parsed_frame->{{ atom.name }}
{%- endif -%}
{%- endmacro -%}

{%- macro function_definitions(bus, msg, msg_name=msg.name) -%}
{%- if msg.frame is defined -%}
{% for sub_frame in msg.frame -%}
{{ function_definitions(bus, sub_frame, msg_name + '_' + sub_frame.name) }}
{%- endfor -%}
{%- else %}
void CANlib_FrameToPoint_{{ bus.name }}_{{ msg_name }}(Frame *frame, Point* point) {
  CANlib_{{ bus.name }}_{{ msg_name }}_T* parsed_frame = new CANlib_{{ bus.name }}_{{ msg_name }}_T();
  CANlib_Unpack_{{ bus.name }}_{{ msg_name }}(frame, parsed_frame);
  point->setMeasurement("{{ bus.name.capitalize() }}_{{ msg_name }}");
  {% for atom in msg.atom -%}
  point->addField("{{ atom.name }}", {{ get_atom_value(atom) }});
  {% endfor -%};
}
{% endif -%}
{%- endmacro -%}

#include "pack_unpack.h"
#include "bus.h"
#include "driver.h"
#include "Point.h"
using namespace influxdb;

#define LIMIT(name)                                         \
  static Time_T last_sent = 0;                              \
  if (CANlib_GetTick() - last_sent < name##_period) return; \
  last_sent = CANlib_GetTick();

// Functions
{% for bus in can.bus %}
// {{ bus.name }}
{% for msg in bus.frame -%}
{{- function_definitions(bus, msg) -}}
{%- endfor -%}
{%- endfor -%}
